# Environment Variables Template
# Copy to .env and fill in your values

# Environment
ENV=development
DEBUG=true

# Server
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/designaudit_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage - AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=designaudit-uploads-dev
AWS_REGION=us-east-1

# Storage - Vercel Blob (Alternative)
VERCEL_BLOB_TOKEN=your_vercel_blob_token

# AI APIs
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk_your-groq-key

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CLERK_API_KEY=your-clerk-api-key
CLERK_SECRET_KEY=your-clerk-secret-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=DEBUG

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Audit Timeouts (seconds)
AUDIT_TIMEOUT_SECONDS=300
INSPECTOR_TIMEOUT=60
ANALYST_TIMEOUT=30
ADVISOR_TIMEOUT=120

# Feature Flags
ENABLE_HEATMAP=true
ENABLE_CHAT=true
ENABLE_BATCH_AUDITS=false
